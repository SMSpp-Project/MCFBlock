##############################################################################
################################ makefile-s ##################################
##############################################################################
#                                                                            #
#   makefile of MCFBlock and its dependencies, excluding SMS++               #
#                                                                            #
#   The makefile defines internally all external libraries required by       #
#   MCFBlock, excluding the SMS++ core ones whose symbols are assumed to     #
#   have been defined already (typically by including SMS++/lib/makefile).   #
#   Accordingly, all necessary OBJ, H, -I directives, external libraries +   #
#   -L< libdirs > are added to the corresponding MCFBk* macros.              #
#                                                                            #
#   Input:  $(CC)       = compiler command                                   #
#           $(SW)       = compiler options                                   #
#           $(SMS++INC) = the -I$( core SMS++ directory )                    #
#           $(SMS++OBJ) = the core SMS++ library                             #
#           $(MCFBkSDR) = the directory where MCFBlock source is             #
#                                                                            #
#   Output: $(MCFBkOBJ) = the final object(s) / library                      #
#           $(MCFBkLIB) = external libraries + -L< libdirs >                 #
#           $(MCFBkH)   = the .h files to include for MCFBlock               #
#           $(MCFBkINC) = the -I$( MCFBlock directory )                      #
#                                                                            #
#                              Antonio Frangioni                             #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

# define & include the necessary modules- - - - - - - - - - - - - - - - - - -
# if a module is not used in the current configuration, just comment out the
# corresponding include line
# each module outputs some macros to be used here:
# *OBJ is the final object/library
# *H   is the list of all include files
# *INC is the -I< include directories >

# include the makefile requiring all external modules in input
include $(MCFBkSDR)/makefile

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

# append external -I directives to MCFBkINC, MCFBkOBJ and MCFBkH as defined
# by the makefile, thus the := assignment has to be used (use GNU make)
MCFBkOBJ := $(MCFBkOBJ)
MCFBkINC := $(MCFBkINC)

# external libraries for MCFBlock
MCFBkLIB =

########################### End of makefile-s ################################
